{
  "name": "disruptive/disruptive-studio",
  "description": "Services for MLM Companies",
  "type": "project",
  "require": {
    "php": "^8.3",
    "phpmailer/phpmailer": "^6.10",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\Controllers\\": "app/Controllers/",
      "App\\Models\\": "app/Models/",
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
